# Copy this file to .env (locally) or set these in Render > Environment.
RAPIDAPI_KEY=your_key_here
# Exact address of your Cloudflare Pages site, no trailing slash
ALLOWED_ORIGIN=https://your-site.pages.dev

# --- YouTube (all optional) ---
# Biggest quality offered (1080 is the default)
# YT_MAX_HEIGHT=1080
# Longest video accepted, in minutes
# YT_MAX_MINUTES=30
# Videos built at the same time (keep at 1 on Render's free plan)
# YT_MAX_JOBS=1
# If YouTube says "Sign in to confirm you're not a bot" in the Render logs, add ONE of these:
#  - a Render Secret File named cookies.txt (it appears at /etc/secrets/cookies.txt), or
#  - YT_COOKIES_FILE=/path/to/cookies.txt
#  - YT_PROXY=http://user:pass@host:port
